[Unit]
Description=Jangid Associate CRM FastAPI service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/jangid-associate-crm/backend
EnvironmentFile=/var/www/jangid-associate-crm/backend/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/var/www/jangid-associate-crm/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
